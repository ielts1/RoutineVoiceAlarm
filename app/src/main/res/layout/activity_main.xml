<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F4F6FF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header -->

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:background="#4F46E5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:src="@drawable/routine_voice_alarm_skp"
            android:contentDescription="Routine Voice Alarm"
            android:scaleType="centerInside"
            android:layout_width="58dp"
            android:layout_height="58dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:text="Routine"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Voice Alarm • SKP"
                android:textColor="#E0E7FF"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/settingsButton"
            android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="Settings"
            android:background="@android:color/transparent"
            android:tint="#FFFFFF"
            android:padding="10dp"
            android:layout_width="52dp"
            android:layout_height="52dp"/>

    </LinearLayout>


    <!-- Scrollable Home -->

    <ScrollView
        android:fillViewport="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Statistics -->

            <LinearLayout
                android:orientation="horizontal"
                android:weightSum="4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="#DBEAFE"
                    android:layout_margin="3dp"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/totalCount"
                        android:text="0"
                        android:textColor="#1D4ED8"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Total"
                        android:textColor="#1E3A8A"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>


                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="#DCFCE7"
                    android:layout_margin="3dp"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/activeCount"
                        android:text="0"
                        android:textColor="#15803D"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Active"
                        android:textColor="#166534"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>


                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="#FEE2E2"
                    android:layout_margin="3dp"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/disabledCount"
                        android:text="0"
                        android:textColor="#DC2626"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="OFF"
                        android:textColor="#991B1B"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>


                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="#EDE9FE"
                    android:layout_margin="3dp"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/todayCount"
                        android:text="0"
                        android:textColor="#7C3AED"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Today"
                        android:textColor="#5B21B6"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </LinearLayout>


            <!-- Today -->

            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="14dp"
                android:background="#FFFFFF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Today"
                    android:textColor="#111827"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/today"
                    android:textColor="#6B7280"
                    android:textSize="15sp"
                    android:layout_marginTop="3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>


            <!-- Section title -->

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Today's Alarms"
                    android:textColor="#111827"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/todayLabel"
                    android:text="0"
                    android:textColor="#4F46E5"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>


            <!-- Alarm list -->

            <LinearLayout
                android:id="@+id/alarmList"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </ScrollView>


    <!-- Add button -->

    <Button
        android:id="@+id/addButton"
        android:text="+  Add Routine Alarm"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#4F46E5"
        android:layout_margin="14dp"
        android:layout_width="match_parent"
        android:layout_height="58dp"/>

</LinearLayout>
